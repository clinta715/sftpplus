import argparse
import pysftp

def sftp_transfer(hostname, username, password, local_path, remote_path):
    with pysftp.Connection(hostname, username=username, password=password) as sftp:
        print(f"Connected to {hostname}")
        
        # Upload file from local to remote
        sftp.put(local_path, remote_path)
        print(f"File '{local_path}' uploaded to '{remote_path}'")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Transfer files via SFTP.")
    parser.add_argument("hostname", help="SFTP server's hostname or IP address")
    parser.add_argument("username", help="SFTP username")
    parser.add_argument("password", help="SFTP password")
    parser.add_argument("local_path", help="Path to the local file")
    parser.add_argument("remote_path", help="Path to the remote file")

    args = parser.parse_args()

    sftp_transfer(args.hostname, args.username, args.password, args.local_path, args.remote_path)
