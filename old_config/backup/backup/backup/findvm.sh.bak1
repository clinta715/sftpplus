#!/bin/bash

# Check if the required argument is provided
if [ $# -eq 0 ]; then
  echo "Usage: $0 <vm_name_to_compare>"
  exit 1
fi

# The name of the VM to compare is the first command-line argument
vm_name_to_compare="$1"

# List of ESXi servers (replace with your own list)
esxi_servers=("172.16.1.28" "172.16.1.10" "172.16.1.11")

# Function to check if a VM is present on an ESXi server
check_vm_on_server() {
  local server="$1"
  local vm_name="$2"
  
  # Use SSH to execute vim-cmd vmsvc/getallvms and extract VM names
  vm_list=$(ssh "root@$server" "vim-cmd vmsvc/getallvms" | awk '{if (NR>1) print $2}')

  echo "$vm_list"

  # Check if the provided VM name is found in the list
  if echo "$vm_list" | grep -q "$vm_name"; then
    echo "VM '$vm_name' found on $server"
  else
    echo "VM '$vm_name' not found on $server"
  fi
}

# Loop through the ESXi servers
for server in "${esxi_servers[@]}"; do
  echo "Connecting to $server..."
  check_vm_on_server "$server" "$vm_name_to_compare"
  echo "=================================="
done
